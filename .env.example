# CypherCore WhatsApp Bot - Environment Configuration
# Copy this file to .env and fill in your actual values

# Meta WhatsApp API Configuration
# Get these from your Meta Business Platform Dashboard
WHATSAPP_TOKEN=your_whatsapp_bearer_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
VERSION=v20.0

# Webhook Security
# Generate a random string for hub.verify_token (used in webhook setup)
VERIFY_TOKEN=your_random_verify_token_here

# App Secret
# Found in: App Settings > Basic > App Secret (requires confirmation)
APP_SECRET=your_app_secret_here

# Environment
# Options: development, staging, production
ENVIRONMENT=development

# Logging
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
